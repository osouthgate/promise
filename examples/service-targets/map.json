{
  "version": 1,
  "docRoot": ".",
  "servicePolicies": [
    {
      "id": "interactive-search",
      "kind": "quantitative",
      "revision": "1",
      "boundary": "submit to complete visible results",
      "workload": "10000 notes, 20 concurrent signed-in users",
      "metric": "duration",
      "unit": "ms",
      "direction": "lower",
      "aggregation": "each-sample",
      "target": 1000,
      "unacceptable": 10000,
      "windowSeconds": 3600,
      "minSamples": 2,
      "maxAgeSeconds": 300,
      "guardrails": [
        {
          "metric": "duration",
          "unit": "ms",
          "operator": "at-least",
          "value": 0
        },
        {
          "metric": "relevance",
          "unit": "score",
          "operator": "at-least",
          "value": 0.8
        },
        {
          "metric": "relevance",
          "unit": "score",
          "operator": "at-most",
          "value": 1
        },
        {
          "metric": "correct",
          "unit": "boolean",
          "operator": "at-least",
          "value": 1
        },
        {
          "metric": "correct",
          "unit": "boolean",
          "operator": "at-most",
          "value": 1
        }
      ],
      "acceptableWhen": [
        {
          "metric": "relevance",
          "unit": "score",
          "operator": "at-least",
          "value": 0.95
        }
      ]
    },
    {
      "id": "request-availability",
      "kind": "quantitative",
      "revision": "1",
      "boundary": "all completed or timed-out requests at the public API",
      "workload": "10000 notes, 20 concurrent signed-in users",
      "metric": "request-success",
      "unit": "%",
      "direction": "higher",
      "aggregation": "request-success-ratio",
      "target": 99.9,
      "unacceptable": 99,
      "windowSeconds": 3600,
      "minSamples": 2,
      "maxAgeSeconds": 300,
      "guardrails": [],
      "acceptableWhen": []
    },
    {
      "id": "loaded-throughput",
      "kind": "quantitative",
      "revision": "1",
      "boundary": "completed requests per second in each 60-second interval",
      "workload": "open-loop offered load of at least 120 requests/s, 10000 records",
      "metric": "completed-throughput",
      "unit": "requests/s",
      "direction": "higher",
      "aggregation": "each-sample",
      "target": 100,
      "unacceptable": 80,
      "windowSeconds": 3600,
      "minSamples": 2,
      "maxAgeSeconds": 300,
      "guardrails": [
        {
          "metric": "offered-load",
          "unit": "requests/s",
          "operator": "at-least",
          "value": 120
        },
        {
          "metric": "p95-duration",
          "unit": "ms",
          "operator": "at-most",
          "value": 1000
        }
      ],
      "acceptableWhen": []
    },
    {
      "id": "accessible-interface",
      "kind": "assessment",
      "revision": "1",
      "basis": "The applicable WCAG AA success criteria for the named journeys.",
      "standard": {
        "name": "WCAG",
        "version": "2.2 AA"
      },
      "scope": "search and checkout journeys, desktop and mobile, build example-1",
      "method": "automated scan plus keyboard and screen-reader assessment",
      "criteria": {
        "target": "All applicable AA criteria pass in scope.",
        "unacceptable": "Any applicable AA criterion fails in scope."
      },
      "maxAgeSeconds": 86400
    }
  ],
  "rows": [
